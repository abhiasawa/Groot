.expo/
dist/
web-build/

.kotlin/
*.orig.*
*.p8
*.p12
*.mobileprovision

.metro-health-check*

npm-debug.*
yarn-debug.*
yarn-error.*

.DS_Store

*.tsbuildinfo

/ios
/android
