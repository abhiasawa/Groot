{
  "expo": {
    "name": "Noto",
    "slug": "noto",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "thegarden",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFBF0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.groot.thegarden"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFBF0"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.groot.thegarden",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FFFBF0",
          "defaultChannel": "groot-reminders",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos to your messages",
          "cameraPermission": "Take photos to send to Groot"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Record voice messages for Groot"
        }
      ],
      "expo-sensors",
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin",
      "react-native-health-connect",
      "./plugins/withHealthConnect.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "42c122e3-dfca-422b-b031-d126618981af"
      }
    },
    "owner": "asawa"
  }
}
