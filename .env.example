# ─── WhatsApp Cloud API (Meta) ───
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_string
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
META_APP_SECRET=your_meta_app_secret

# ─── Anthropic (Claude) ───
ANTHROPIC_API_KEY=sk-ant-xxxxx
# ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5-20250514

# ─── Supermemory ───
SUPERMEMORY_API_KEY=your_supermemory_api_key

# ─── OpenAI (Whisper + TTS) ───
OPENAI_API_KEY=sk-xxxxx
# OPENAI_CHAT_MODEL=gpt-5-mini

# ─── Supabase ───
# Supabase now uses sb_publishable_ (replaces anon key) and sb_secret_ (replaces service_role key)
# Get these from: Supabase Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx

# ─── Upstash Redis (Rate Limiting) ───
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ─── Upstash QStash (Cron Scheduling) ───
QSTASH_TOKEN=your_qstash_token
QSTASH_CURRENT_SIGNING_KEY=your_current_signing_key
QSTASH_NEXT_SIGNING_KEY=your_next_signing_key

# ─── AI Provider Config ───
AI_PROVIDER=openai
VISION_PROVIDER=anthropic
TRANSCRIPTION_PROVIDER=openai
TTS_PROVIDER=openai
TTS_VOICE=nova
# WhatsApp latency tuning (optional)
WHATSAPP_CONTEXT_RECENT_LIMIT=6
WHATSAPP_MEMORY_SEARCH_LIMIT=2
WHATSAPP_RESPONSE_MAX_TOKENS=512

# ─── Telegram Bot (optional) ───
# Create a bot via @BotFather on Telegram to get these
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=your_random_secret_string

# ─── Optional: Google Gemini ───
# GOOGLE_GEMINI_API_KEY=your_gemini_key

# ─── App Config ───
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
CRON_SECRET=your_cron_secret_for_vercel
OWNER_WHATSAPP_NUMBER=919876543210
OWNER_EMAIL=you@example.com

# ─── Auth ───
# Generate a random 32+ character string: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

# Dev-only: allow fallback to latest user when no JWT/cookie is present.
# Keep this false/absent in production.
# ALLOW_SINGLE_USER_FALLBACK=true
